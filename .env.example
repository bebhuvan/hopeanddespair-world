# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Prose generation provider — DeepSeek by default, swappable behind src/lib/llm.ts.
# Used only by the offline authoring/update pipeline, never at request time or in the client.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Later: R2 / Cloudflare credentials for the chart-artifact store (PLAN.md §4).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
