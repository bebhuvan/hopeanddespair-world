# Copy to .env and fill in. NEVER commit .env (it is gitignored). NEVER paste this key in chat.
# Prose-generation provider — DeepSeek by default, swappable behind scripts/lib/llm.ts.
# OFFLINE ONLY: used by authoring/update scripts, never at request time and never in the client.
# Verify with: pnpm llm:check
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to the exact model id from DeepSeek's docs (e.g. deepseek-chat, deepseek-reasoner).
DEEPSEEK_MODEL=deepseek-chat

# Later: R2 / Cloudflare credentials for the chart-artifact store (PLAN.md §4).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
