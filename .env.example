# Copy to .env and fill in. NEVER commit .env (it is gitignored). NEVER paste this key in chat.
# Prose-generation provider — DeepSeek by default, swappable behind scripts/lib/llm.ts.
# OFFLINE ONLY: used by authoring/update scripts, never at request time and never in the client.
# Verify with: pnpm llm:check
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set to the exact model id from DeepSeek's docs (e.g. deepseek-chat, deepseek-reasoner).
DEEPSEEK_MODEL=deepseek-chat

# Ember Energy API (CC BY 4.0) — re-hostable electricity/energy series for the green-transition
# dimension (replaces the link-only OWID energy series; see docs/ARTICLE-keystone-plan.md §7).
# Get a key at https://api.ember-energy.org/v1/docs
EMBER_API_KEY=
EMBER_BASE_URL=https://api.ember-energy.org

# FAOSTAT (faostatservices.fao.org) — hunger/agriculture detail. LICENSE: CC BY-NC-SA 3.0 IGO →
# LINK-ONLY (the NC clause forbids re-host even with API access); the re-host route for hunger is
# the World Bank FAOSTAT mirror SN.ITK.DEFC.ZS (CC BY). Use FAO-direct only for cited, non-download
# enrichment. An access token is short-lived (~60 min): for the scheduled pipeline set USERNAME +
# PASSWORD and let the adapter exchange them per run via /api/v1/auth/login. Token is for testing.
FAO_USERNAME=
FAO_PASSWORD=
FAO_ACCESS_TOKEN=

# Later: R2 / Cloudflare credentials for the chart-artifact store (PLAN.md §4).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
