# build output
dist/
.astro/

# raw source bytes → R2/Git-LFS at scale, not git (DATA.md §2). The snapshot.json manifest
# (checksum + vintage + license) stays tracked; the bytes are reproducible from it.
data/sources/**/raw.*

# deps
node_modules/

# env & secrets — never commit the DeepSeek key
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# OG card font cache (instanced TTFs, regenerated by pnpm og)
scripts/.og-fonts/

# wrangler local dev state/cache
.wrangler/
