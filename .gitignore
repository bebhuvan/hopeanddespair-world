# build output
dist/
.astro/

# raw source snapshots → not git (DATA.md §2): large (~700 MB) + reproducible — each derived
# series in src/data/derived carries its own vintage + checksum, and the analysis scripts re-fetch.
# Kept local; at scale these belong in R2/Git-LFS. (If you ever need a manifest tracked, add a
# narrow "!data/sources/.../snapshot.json" exception and `git add -f` it.)
data/sources/

# deps
node_modules/

# env & secrets — never commit the DeepSeek key
.env
.env.*
!.env.example

# os / editor
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# OG card font cache (instanced TTFs, regenerated by pnpm og)
scripts/.og-fonts/

# wrangler local dev state/cache
.wrangler/
