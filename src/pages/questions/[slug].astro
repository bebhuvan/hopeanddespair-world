---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { miniLine, signalRead } from '../../lib/charts';
import { windowSeries } from '../../lib/smooth';
import { gitHistory, fileHistoryUrl } from '../../lib/repo';
import { smartenDeep } from '../../lib/typo';
import { buildMovements } from '../../lib/article-charts';
import { buildDimensions } from '../../lib/keystone-charts';
import Chart from '../../components/Chart.astro';

export async function getStaticPaths() {
  const questions = await getCollection('questions');
  return questions.map((q) => ({ params: { slug: q.id }, props: { q } }));
}

const { q } = Astro.props;
const d = smartenDeep(q.data);
// Per-article Open Graph card (generated by `pnpm og` into public/og/<slug>.png). Fall back to the
// site default when an article has none (e.g. a draft); BaseLayout supplies /og.png for undefined.
const ogImage = existsSync(`public/og/${q.id}.png`) ? `/og/${q.id}.png` : undefined;
const tempCol = (t: string) => (t === 'cool' ? 'var(--hope)' : 'var(--despair)');
const published = d.status === 'published' && d.evidence;

// Evidence — the static four-magnification row + signals (built at compile time; no client JS)
let windows: any[] = [], signals: any[] = [], tally = '', recentCol = '';
if (published && d.evidence) {
  const ev = d.evidence;
  windows = ev.windows.map((w, i) => {
    const r = miniLine({ data: windowSeries(ev.hero, w.from, w.to), color: tempCol(w.temp), width: 300, height: 56, area: true, baseline: true, id: 'w' + i });
    return { ...w, ...r, col: tempCol(w.temp) };
  });
  let good = 0, bad = 0;
  signals = ev.signals.map((s, i) => {
    const rd = signalRead(s.data, ev.recentFrom, ev.recentTo, s.badUp);
    rd.good ? good++ : bad++;
    const col = rd.good ? 'var(--hope)' : 'var(--despair)';
    const r = miniLine({ data: rd.data, color: col, width: 300, height: 50, area: true, id: 'sig' + i });
    return { ...s, ...rd, col, ...r };
  });
  tally = `<b>${bad}</b> of ${ev.signals.length} signals point to deterioration · <b>${good}</b> toward progress`;
  recentCol = tempCol(ev.recentTemp);
}

// Rendered movement charts — built in src/lib/article-charts.ts, shared with the
// standalone chart.svg download endpoint so the page and the artifact can never drift.
// A movements-led article (real charts, no single-metric evidence panel) is also a full render,
// not a stub — as long as it is published and has movements.
const hasMovements = d.status === 'published' && (d.movements?.length ?? 0) > 0;
const movements = buildMovements((published || hasMovements) ? d.movements ?? [] : []);

// The keystone hub — each dimension a mini-suite of real derived series, grouped by temperature.
const dimensions = buildDimensions(d.dimensions ?? []);
const isHub = dimensions.length > 0;
// The hub has no single-metric `evidence` block, so it isn't "published" in the old sense — but it
// still renders its full back matter (cases, what-would-change-it, methodology, sources, closing).
// A movements-led article (real charts, no evidence panel) likewise earns its back matter.
const showArticle = published || isHub || hasMovements;
const clusters = [
  { key: 'better', label: 'What we are winning', sub: 'where the verdict is clearly yes' },
  { key: 'worse', label: 'What we are losing', sub: 'where the verdict is clearly no' },
  { key: 'both', label: 'What is genuinely both', sub: 'where the verdict splits — and the article is most itself' },
];
// The attribution line under each chart, generated from the series' own provenance (never hand-typed).
const srcLine = (p: any) => p ? `Source · ${p.attribution}${p.primarySource ? ` — ${p.primarySource}` : ''} · ${p.license}` : '';

// Revision history — generated from git (the living-atlas trail).
const contentPath = `src/content/questions/${q.id}.md`;
const history = gitHistory(contentPath);
const histUrl = fileHistoryUrl(contentPath);

// The lived-now interlude — a tonal pivot drawn from the article's own data (the "living it"
// lens, falling back to the vantage note). The despair read, spoken in despair colour.
const livedLens = (published ? d.lenses ?? [] : []).find((l) => /liv/i.test(l.who) && l.despair);
const interludeRaw = livedLens?.despair ?? (published ? d.evidence?.vantageNote ?? null : null);
let ilLead: string | null = interludeRaw, ilPunch = '';
if (interludeRaw) {
  const m = interludeRaw.match(/^(.*\.)\s+([^.]+\.?)$/);   // lead sentence(s) + the closing punch
  if (m) { ilLead = m[1]; ilPunch = m[2]; }
}
// No sub-text under the quote: it used to repeat the composite's vantage note verbatim
// two screens later — the quote stands alone.

// The closing "Still lost? Read this." box + AI disclosure, authored as the markdown body.
const { Content } = await render(q);

// Recipe steps arrive as lowercase fragments; print them as sentences, not a semicolon chain.
const sentence = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).replace(/\.?$/, '.');

const title = `${d.question} — Hope & Despair`;

// Citation + disclosure metadata. The canonical URL and BibTeX let the atlas be cited the way
// a dataset or article is — selectable text, no client JS needed (the reader copies it).
// The metric the evidence panel zooms — named so "one number, four magnifications" has an
// antecedent. heroLabel is authored as "name / unit"; the first segment is the number's name.
const heroName = (d.evidence?.heroLabel ?? '').split(/\s*[/·]\s*/)[0];
const canonical = `https://hopeanddespair.world/questions/${q.id}`;
const pubYear = new Date(q.data.publishedAt).getFullYear();
const updated = history[0]?.date ?? null;
const citation = `Hope & Despair. “${d.question}.” Hope & Despair, ${pubYear}. ${canonical}.`;
const bibtex = `@misc{hopeanddespair:${q.id},
  author       = {{Hope & Despair}},
  title        = {{${d.question}}},
  year         = {${pubYear}},
  howpublished = {\\url{${canonical}}},
  note         = {hopeanddespair.world${updated ? `, updated ${updated}` : ''}}
}`;

// Article structured data — grounds search engines and LLMs in what this page is, when it
// changed, who made it, and that it is free + openly licensed.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.question,
  description: d.dek,
  url: canonical,
  datePublished: new Date(q.data.publishedAt).toISOString().slice(0, 10),
  dateModified: updated ?? new Date(q.data.publishedAt).toISOString().slice(0, 10),
  inLanguage: 'en',
  isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/',
  author: { '@type': 'Person', name: 'Bhuvan', url: 'https://bebhuvan.com' },
  publisher: { '@type': 'Organization', name: 'Hope & Despair', url: 'https://hopeanddespair.world' },
  mainEntityOfPage: canonical,
};

const sec = ['I', 'II', 'III', 'IV', 'V', 'VI'];
// Figures are the movement charts, numbered from 1 — the evidence sparklines are not
// figures (the old scheme started readers at "Fig. 6" with no visible 1–5).
const figStart = 1;
---
<BaseLayout title={title} description={d.dek} type="article" image={ogImage} jsonld={articleLd}>
  <article class="qbody">
    <!-- header -->
    <div class="row">
      <div class="g"></div>
      <div class="c">
        <p class="kicker">Question {d.kickerNumber} <span class="sep">·</span> {d.theme}</p>
        <h1 class="title">{d.question}</h1>
        <p class="lede">{d.dek}</p>
      </div>
    </div>

    {showArticle && d.intro && (
      <div class="row block">
        <div class="g"></div>
        <div class="c intro">{d.intro.map((p: string) => <p set:html={p} />)}</div>
      </div>
    )}

    {!published && !isHub && !hasMovements && (
      <div class="row block">
        <div class="g"></div>
        <div class="c"><p class="draft-note">This article is being written. Its place on the hope↔despair atlas is
          set — the full evidence, charts, and explanation are on the way. <a href="/">← Back to the atlas</a></p></div>
      </div>
    )}

    {isHub && clusters.map((cl) => {
      const dims = dimensions.filter((dm: any) => dm.cluster === cl.key);
      if (!dims.length) return null;
      return (
        <section class="cluster">
          <div class="row block"><div class="g"></div><div class="c">
            <div class="cl-head"><span class="cl-t">{cl.label}</span><span class="cl-s">{cl.sub}</span></div>
          </div></div>
          {dims.map((dm: any) => (
            <div class="row dim">
              <div class="g"><div class={`epi epi-${dm.epistemic}`}>{dm.epistemic}</div></div>
              <div class="c">
                <div class="dverdict">
                  <span style={`color:${tempCol(dm.verdictTemp)}`}>{dm.verdict}</span>
                  {dm.verdict2 && <><span class="vslash">/</span><span style={`color:${tempCol(dm.verdict2Temp)}`}>{dm.verdict2}</span></>}
                </div>
                <h2 class="dname">{dm.name}</h2>
                <p class="dim-claim">{dm.claim}</p>
                {dm.explainer && <p class="dim-ex">{dm.explainer}</p>}

                {[dm.carryingChart, dm.counterChart, ...(dm.secondaryCharts ?? [])].filter(Boolean).map((c: any) => (
                  <figure class="kfig">
                    <figcaption class="kcap"><span class="lab" set:html={c.label} /><span class="u">{c.unit} <span class="yr">· {c.span}</span></span></figcaption>
                    <div class="sc"><Chart c={c} /></div>
                    {c.note && <p class="knote" set:html={c.note} />}
                    <div class="kfoot">
                      {!c.linkOnly && (
                        <span class="tools"><a href={`/charts/${c.dataRef}/chart.svg`} download>↓ image, svg</a><a href={`/charts/${c.dataRef}/data.csv`} download>↓ data, csv</a><a href={`/charts/${c.dataRef}/datapackage.json`}>↓ data package</a><a href={`/charts/${c.dataRef}/lineage.json`}>↗ lineage</a></span>
                      )}
                      <span class="src">{srcLine(c.prov)}{c.linkOnly ? ' · link-only, not for download' : ''}</span>
                    </div>
                  </figure>
                ))}
                {dm.regionalChart && (
                  <figure class="kfig">
                    <figcaption class="kcap"><span class="lab" set:html={dm.regional.label} /><span class="u yr">{dm.regionalChart.span}</span></figcaption>
                    <div class="sc"><Chart c={dm.regionalChart} /></div>
                    {dm.regionalChart.note && <p class="knote" set:html={dm.regionalChart.note} />}
                    <div class="kfoot">
                      {!dm.regionalChart.linkOnly && (
                        <span class="tools"><a href={`/charts/${dm.regionalChart.dataRef}/regions.svg`} download>↓ image, svg</a></span>
                      )}
                      <span class="src">{srcLine(dm.regionalChart.prov)}</span>
                    </div>
                  </figure>
                )}
                {dm.countryChart && (
                  <figure class="kfig">
                    <figcaption class="kcap"><span class="lab" set:html={dm.countries.label} /><span class="u">{dm.countryChart.unit} {dm.countryChart.span && <span class="yr">· {dm.countryChart.span}</span>}</span></figcaption>
                    <div class="sc"><Chart c={dm.countryChart} /></div>
                    {dm.countryChart.note && <p class="knote" set:html={dm.countryChart.note} />}
                    <div class="kfoot">
                      <span class="src">{srcLine(dm.countryChart.prov)}</span>
                    </div>
                  </figure>
                )}
                {dm.countryTrendChart && (
                  <figure class="kfig">
                    <figcaption class="kcap"><span class="lab" set:html={dm.countryTrend.label} /><span class="u yr">{dm.countryTrendChart.span}</span></figcaption>
                    <div class="sc"><Chart c={dm.countryTrendChart} /></div>
                    {dm.countryTrendChart.note && <p class="knote" set:html={dm.countryTrendChart.note} />}
                    <div class="kfoot">
                      <span class="src">{srcLine(dm.countryTrendChart.prov)}</span>
                    </div>
                  </figure>
                )}

                <div class="takes">
                  <div class="hope"><div class="t">Hope</div><p>{dm.take.hope}</p></div>
                  <div class="desp"><div class="t">Despair</div><p>{dm.take.despair}</p></div>
                  <div class="conf"><div class="t">Confusion</div><p>{dm.take.confusion}</p></div>
                </div>
                {dm.deepLink && <a class="deep" href={dm.deepLink}>Go deeper into {dm.name.toLowerCase()} →</a>}
              </div>
            </div>
          ))}
        </section>
      );
    })}

    {showArticle && d.caveats && (
      <div class="row block caveats">
        <div class="g"><div class="glabel">Before<br>you read</div></div>
        <div class="c"><ul>{d.caveats.map((c) => <li set:html={c} />)}</ul></div>
      </div>
    )}

    {published && d.evidence && (
      <div class="row block evi">
        <div class="g"><div class="glabel">The<br>evidence</div></div>
        <div class="c">
          <div class="head">
            <div class="t"><b>One number, read at four magnifications.</b> That number is
              {heroName && <b class="metric">{heroName}</b>} — the same measure, zoomed from the longest view
              this question allows down to the most recent.</div>
            <div class="legend"><span><i style="background:var(--hope)"></i>improving</span><span><i style="background:var(--despair)"></i>worsening</span></div>
          </div>
          <div class="windows zoom">
            {windows.map((w, i) => (
              <div class="win">
                <div class="wn">{String(i + 1).padStart(2, '0')}{i < windows.length - 1 && <span class="ar">→</span>}</div>
                <div class="wr">{w.range}</div>
                <div class="wl">{w.lab}</div>
                <svg viewBox={w.viewBox} preserveAspectRatio="none" aria-hidden="true" set:html={w.inner} />
                <div class:list={['wv', w.temp === 'cool' ? 'cool' : 'warm']}>{w.verdict}<span class="p">.</span></div>
              </div>
            ))}
          </div>
          <p class="readout" set:html={d.evidence.readout} />

          <div class="sig-head">Now four <em>separate</em> signals <span class="r">· different measures, {d.evidence.windows[2]?.range ?? 'recent'}</span></div>
          <div class="signals">
            {signals.map((s) => (
              <div class="sig">
                <div class="nm">{s.name}</div>
                <div class="un">{s.unit}</div>
                <svg viewBox={s.viewBox} preserveAspectRatio="none" aria-hidden="true" set:html={s.inner} />
                <div class="rd"><span class="v">{s.value}</span><span class="dir" style={`color:${s.col}`}>{s.up ? '↑' : '↓'} {s.good ? 'improving' : 'worsening'}</span></div>
              </div>
            ))}
          </div>

          <div class="composite">
            <div><div class="vlab">The recent verdict</div><div class="vbig" style={`color:${recentCol}`}>{d.evidence.recentVerdict}<span class="p">.</span></div></div>
            <div>
              <p class="synth" set:html={d.evidence.synthesis} />
              <p class="tally" set:html={tally} />
              <p class="vantage" set:html={d.evidence.vantageNote} />
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- the lived-now interlude: a temperature shift, not a black slab -->
    {published && ilLead && (
      <section class="interlude bleed">
        <div class="in">
          <p class="e">the lived now</p>
          <blockquote>{ilLead}{ilPunch && <> <b>{ilPunch}</b></>}</blockquote>
        </div>
      </section>
    )}

    <!-- movements -->
    {movements.map((mv, i) => (
      <div class="row move">
        <div class="g"><div class="fno">Fig.&nbsp;{figStart + i}</div></div>
        <div class="c">
          <div class="ey">{mv.eyebrow}</div>
          <h2>{mv.question ?? mv.claim}</h2>
          {mv.sidenote && (<aside class="sidenote"><span class="n">{mv.sidenote.mark}.</span><span set:html={mv.sidenote.text} /></aside>)}
          {mv.question && <p class="answer">{mv.claim}</p>}
          {mv.explainer.split(/\n\n+/).map((para: string) => <p class="intro" set:html={para} />)}
          <figure class="fig">
            <div class="cap"><span set:html={mv.captionLeft} /><span>{mv.captionRight}</span></div>
            <div class="sc"><Chart c={mv} /></div>
            <figcaption>
              {mv.real && mv.dataRef && (
                <div class="tools"><a href={`/charts/${mv.dataRef}/fig${figStart + i}.svg`} download>↓ image, svg</a><a href={`/charts/${mv.dataRef}/data.csv`} download>↓ data, csv</a><a href={`/charts/${mv.dataRef}/datapackage.json`}>↓ data package</a><a href={`/charts/${mv.dataRef}/lineage.json`}>↗ lineage</a></div>
              )}
              <div class="src">{mv.source}</div>
            </figcaption>
            {mv.real && mv.prov && (
              <details class="prov">
                <summary>How this number was made</summary>
                <div class="pb">
                  <p><b>What it measures.</b> {mv.prov.definition}</p>
                  {mv.recipe && mv.recipe.length > 0 && (
                    <>
                      <p><b>Calculation.</b> {mv.recipe.map((r: any) => sentence(r.detail)).join(' ')}</p>
                      {mv.kind !== 'bars' && (
                        <p class="fine">The displayed line is monotone-cubic smoothed for legibility only — it never
                          moves a data point.</p>
                      )}
                    </>
                  )}
                  <div class="meta">
                    <span>source · {mv.prov.attribution}{mv.prov.primarySource ? ` (${mv.prov.primarySource})` : ''}</span>
                    <span>license · {mv.prov.license}</span>
                    <span>vintage · {mv.prov.vintage}</span>
                    <span>checksum · {mv.prov.checksum.slice(0, 12)}…</span>
                  </div>
                </div>
              </details>
            )}
          </figure>
          {(mv.regionalChart || mv.countryChart) && (
            <div class="levels">
              {mv.regionalChart && (
                <figure class="kfig">
                  <figcaption class="kcap"><span class="lab" set:html={mv.regional.label} /><span class="u yr">{mv.regionalChart.span}</span></figcaption>
                  <div class="sc"><Chart c={mv.regionalChart} /></div>
                  {mv.regionalChart.note && <p class="knote" set:html={mv.regionalChart.note} />}
                  <div class="kfoot">
                    {!mv.regionalChart.linkOnly && (
                      <span class="tools"><a href={`/charts/${mv.regionalChart.dataRef}/regions.svg`} download>↓ image, svg</a></span>
                    )}
                    <span class="src">{srcLine(mv.regionalChart.prov)}{mv.regionalChart.linkOnly ? ' · link-only, not for download' : ''}</span>
                  </div>
                </figure>
              )}
              {mv.countryChart && (
                <figure class="kfig">
                  <figcaption class="kcap"><span class="lab" set:html={mv.countries.label} /><span class="u">{mv.countryChart.unit} {mv.countryChart.span && <span class="yr">· {mv.countryChart.span}</span>}</span></figcaption>
                  <div class="sc"><Chart c={mv.countryChart} /></div>
                  {mv.countryChart.note && <p class="knote" set:html={mv.countryChart.note} />}
                  <div class="kfoot">
                    {!mv.countryChart.linkOnly && (
                      <span class="tools"><a href={`/charts/${mv.countryChart.dataRef}/bars.svg`} download>↓ image, svg</a></span>
                    )}
                    <span class="src">{srcLine(mv.countryChart.prov)}{mv.countryChart.linkOnly ? ' · link-only, not for download' : ''}</span>
                  </div>
                </figure>
              )}
            </div>
          )}
          <div class="takes">
            <div class="hope"><div class="t">Hope</div><p>{mv.take.hope}</p></div>
            <div class="desp"><div class="t">Despair</div><p>{mv.take.despair}</p></div>
            <div class="conf"><div class="t">Confusion</div><p>{mv.take.confusion}</p></div>
          </div>
        </div>
      </div>
    ))}

    {showArticle && d.pullQuote && (
      <blockquote class="pull">{d.pullQuote.text}<cite>— {d.pullQuote.cite}</cite></blockquote>
    )}

    {showArticle && d.lenses && (
      <div class="row sec">
        <div class="g"><div class="num">{sec[0]}</div></div>
        <div class="c">
          <div class="seclabel">The multi-disciplinary read</div>
          <p class="seclead">One question, read by the fields that actually study it. Each voice is given both its
            most hopeful and its darkest honest reading — with a note on how settled the evidence underneath is.</p>
          {d.lenses.map((l) => (
            <div class="lens">
              <div class="voice"><span class="who">{l.who}</span><span class="conf">confidence · {l.confidence}</span></div>
              <div class="reads">
                {l.hope && <p class="read hope"><span class="tag">the hopeful read</span>{l.hope}</p>}
                {l.despair && <p class="read desp"><span class="tag">the darker read</span>{l.despair}</p>}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {showArticle && d.hopeCase && d.despairCase && (
      <div class="row sec">
        <div class="g"><div class="num">{sec[1]}</div></div>
        <div class="c">
          <div class="seclabel">The two strongest cases</div>
          <div class="duel">
            <div class="hp"><h3>Strongest case for hope</h3><p>{d.hopeCase}</p></div>
            <div class="dp"><h3>Strongest case for despair</h3><p>{d.despairCase}</p></div>
          </div>
        </div>
      </div>
    )}

    {showArticle && d.whatWouldChangeIt && (
      <div class="row sec">
        <div class="g"><div class="num">{sec[2]}</div></div>
        <div class="c"><div class="seclabel">What would change this verdict</div>
          <div class="change">{d.whatWouldChangeIt.split(/\n\n+/).map((para: string) => <p set:html={para} />)}</div>
        </div>
      </div>
    )}

    {showArticle && d.methodology && (
      <div class="row sec method">
        <div class="g"><div class="num">{sec[3]}</div></div>
        <div class="c">
          <div class="seclabel">Methodology</div>
          <p class="seclead">Everything done to the numbers between the source and the chart, disclosed in full. Where
            a choice is editorial rather than measured, we say so.</p>
          <dl>{d.methodology.map((m) => (<><dt>{m.term}</dt><dd set:html={m.detail} /></>))}</dl>
        </div>
      </div>
    )}

    {showArticle && d.sources && (
      <div class="row sec">
        <div class="g"><div class="num">{sec[4]}</div></div>
        <div class="c">
          <div class="seclabel">Sources &amp; references</div>
          <ol class="srcs">
            {d.sources.map((s) => (
              <li><b>{s.name}</b> — <a href={s.url} rel="noopener" target="_blank">{s.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}<span class="ext"> ↗</span></a> · {s.license} · vintage {s.vintage}{s.note && <span class="note">{s.note}</span>}</li>
            ))}
          </ol>

          <details class="cite">
            <summary>Cite this page</summary>
            <div class="cb">
              <p class="cl">Reference</p>
              <p class="ct">{citation}</p>
              <p class="cl">BibTeX</p>
              <pre class="bx">{bibtex}</pre>
              <p class="cn">Original prose, code, and chart designs are released under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener" target="_blank">CC&nbsp;BY&nbsp;4.0&nbsp;↗</a> — reuse freely with attribution. Source datasets keep their own licences, listed above. Add your access date when citing.</p>
            </div>
          </details>
        </div>
      </div>
    )}

    {showArticle && (history.length > 0 || d.revisions) && (
      <div class="row sec">
        <div class="g"><div class="num">{sec[5]}</div></div>
        <div class="c">
          <div class="seclabel">Revision history</div>
          <ol class="changelog">
            {history.length > 0
              ? history.map((r) => (
                  <li><time>{r.date}</time><span class="txt">{r.subject}{' '}{r.url ? <a href={r.url} rel="noopener">View diff →</a> : <span class="sha">{r.short}</span>}</span></li>
                ))
              : d.revisions!.map((r) => (<li><time>{r.date}</time><span class="txt" set:html={r.text} /></li>))}
          </ol>
          <p class="repo-note">Generated from the commit history — every edit to a number, a word, or a chart is
            tracked in the open.{' '}{histUrl && <a href={histUrl} rel="noopener">Browse the full history &amp; diffs on GitHub →</a>}</p>
        </div>
      </div>
    )}

    {showArticle && (
      <section class="plain bleed"><div class="inner"><div class="row"><div class="g"></div><div class="c">
        <p class="e">in plain words</p>
        <div class="plain-body"><Content /></div>
      </div></div></div></section>
    )}

    {showArticle && (
      <aside class="disclosure row" aria-label="How this was written">
        <div class="g">
          <svg class="dmark" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 1.6 a6.4 6.4 0 0 0 0 12.8 z" fill="var(--hope)" />
            <path d="M8 1.6 a6.4 6.4 0 0 1 0 12.8 z" fill="var(--despair)" />
            <line x1="8" y1="1.2" x2="8" y2="14.8" stroke="var(--bg)" stroke-width="0.8" />
            <circle cx="8" cy="8" r="6.4" fill="none" stroke="var(--ink)" stroke-width="0.9" />
          </svg>
        </div>
        <div class="c">
          <p class="dl">How this was written</p>
          <p class="dt"><b>This is a one-person project, made with AI assistance.</b> One person cannot research,
            write, and keep hundreds of these questions current by hand. So the prose here is drafted with a large
            language model working only from the open, cited data — then read, checked, and edited by a human. The
            numbers are never the model’s: every figure traces to a named, openly-licensed source and can be
            downloaded under its chart. Where the evidence is thin or the call is a judgement, the writing says so.</p>
          <p class="dm"><a href="/about">How the atlas is made →</a><a href="/methodology">The method in full →</a></p>
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .qbody { padding-top: clamp(2.5rem, 7vh, 5rem); }
  .block { margin-top: clamp(3rem, 7vh, 5rem); }

  .kicker { font-family: var(--mono); font-size: 0.82rem; letter-spacing: 0.02em; color: var(--hope); }
  .kicker .sep { color: var(--ink-3); }
  .title { font-family: var(--display); font-weight: 640; font-size: clamp(2.7rem, 6.2vw, 5rem); line-height: 1.04; letter-spacing: -0.04em; margin-top: 1.4rem; max-width: 15ch; text-wrap: balance; }
  .lede { max-width: var(--measure); margin-top: 2.1rem; font-size: clamp(1.32rem, 1.9vw, 1.6rem); line-height: 1.46; color: var(--ink-2); text-wrap: pretty; }
  .draft-note { max-width: 60ch; padding-left: 1.4rem; border-left: 2px solid color-mix(in srgb, var(--hope) 45%, transparent); color: var(--ink-2); }
  .draft-note a { color: var(--hope); }

  /* the one label voice — small sentence-case grotesk, never italic, never tracked caps.
     Italic is reserved for voice (quotes, answers, names, emphasis); when it also did the
     labels, the page read as arbitrary italics everywhere. */
  .glabel { font-family: var(--display); font-weight: 560; font-size: 0.8rem; letter-spacing: 0.02em; line-height: 1.4; color: var(--ink-3); padding-top: 0.3rem; }

  /* caveats — one quiet left-rule aside, not a dash list: the em-dash markers fought the
     em-dashes inside the prose (the same glyph doing two jobs inches apart). */
  .caveats ul { list-style: none; display: grid; gap: 0.9rem; max-width: var(--measure); padding-left: 1.4rem; border-left: 1px solid var(--line-2); }
  .caveats li { color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; text-wrap: pretty; }
  .caveats :global(b) { font-weight: 560; color: var(--ink); }

  /* evidence */
  .evi .head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .evi .head .t { font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.45; color: var(--ink-2); text-wrap: balance; }
  .evi .head .t b { font-weight: 560; color: var(--ink); }
  .evi .head .t .metric { border-bottom: 1px solid color-mix(in srgb, var(--hope) 45%, transparent); }
  .evi .head .legend { font-family: var(--mono); font-size: 0.68rem; color: var(--ink-3); display: flex; gap: 1.1rem; }
  .evi .head .legend i { display: inline-block; width: 1.4em; height: 2px; vertical-align: 0.2em; margin-right: 0.45em; }
  .windows { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.2rem, 3vw, 2.6rem); margin-top: 1.6rem; padding-top: 1.7rem; border-top: 1px solid var(--line-2); }
  /* the numbered, arrow-linked sequence says "one metric, progressively zoomed" */
  .win .wn { font-family: var(--mono); font-size: 0.66rem; color: var(--hope); letter-spacing: 0.08em; margin-bottom: 0.6rem; display: flex; align-items: baseline; justify-content: space-between; }
  .win .wn .ar { color: var(--line-2); }
  .win .wr { font-family: var(--mono); font-size: 0.66rem; color: var(--ink-3); }
  .win .wl { font-family: var(--serif); font-weight: 540; font-size: 1.04rem; margin-top: 0.15rem; letter-spacing: 0.004em; }
  .win svg { width: 100%; height: 50px; display: block; overflow: visible; margin-top: 0.7rem; }
  .win .wv { font-family: var(--display); font-weight: 560; font-size: clamp(1.5rem, 2.9vw, 2.1rem); line-height: 1; letter-spacing: -0.03em; margin-top: 0.6rem; }
  .win .wv.cool { color: var(--hope); } .win .wv.warm { color: var(--despair); }
  .win .wv .p { color: var(--ink); }
  .readout { max-width: 56ch; margin-top: 1.8rem; font-size: var(--fs-lede); line-height: 1.56; color: var(--ink-2); text-wrap: pretty; }
  .readout :global(em) { font-style: italic; color: var(--ink); }

  /* a firm divider + a contrasting label make this block read as a different kind of evidence */
  .sig-head { font-family: var(--serif); font-size: 1.12rem; color: var(--ink-2); margin-top: clamp(2.8rem, 7vh, 4.2rem); padding-top: clamp(1.8rem, 4vh, 2.6rem); border-top: 1px solid var(--line-2); }
  .sig-head em { font-style: italic; color: var(--ink); }
  .sig-head .r { font-family: var(--mono); font-style: normal; font-size: 0.68rem; color: var(--ink-3); }
  .signals { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1.4rem, 3vw, 2.6rem); margin-top: 1.3rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .sig .nm { font-family: var(--display); font-weight: 500; font-size: 1.04rem; line-height: 1.1; }
  .sig .un { font-family: var(--mono); font-size: 0.66rem; color: var(--ink-3); margin-top: 0.15rem; }
  .sig svg { width: 100%; height: 46px; display: block; overflow: visible; margin-top: 0.6rem; }
  .sig .rd { display: flex; align-items: baseline; justify-content: space-between; margin-top: 0.5rem; gap: 0.4rem; }
  .sig .v { font-family: var(--mono); font-size: 0.95rem; }
  .sig .dir { font-family: var(--mono); font-size: 0.66rem; white-space: nowrap; }
  @media (max-width: 760px) { .signals, .windows { grid-template-columns: repeat(2, 1fr); gap: 1.8rem 1.4rem; } }

  /* The verdict column is capped so a LONG verdict ("Past the line", "Hotter, yet turning") wraps
     into a poster-style stack instead of claiming the whole row and starving the synthesis — while
     a short one ("No") still sits compact and lets the synthesis run wide. The cap fits the longest
     single word at the display size; the synthesis takes the rest as 1fr. */
  /* verdict-left / synthesis-right. The verdict column is capped tighter (15rem) and the verdict
     type a step smaller, so a long synthesis fills the rest of the row and reads wide instead of
     dribbling down a narrow channel beside a half-empty poster. */
  .composite { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: clamp(1.6rem, 4vw, 3rem); align-items: start; margin-top: clamp(2.4rem, 6vh, 3.6rem); padding-top: 1.8rem; border-top: 1px solid var(--line-2); }
  .composite > * { min-width: 0; }
  .composite .vlab { font-family: var(--display); font-weight: 560; font-size: 0.8rem; letter-spacing: 0.02em; color: var(--ink-3); }
  .composite .vbig { font-family: var(--display); font-weight: 600; font-size: clamp(2.5rem, 5.2vw, 3.8rem); line-height: 0.94; letter-spacing: -0.035em; margin-top: 0.3rem; text-wrap: balance; }
  .composite .vbig .p { color: var(--ink); }
  .composite .synth { font-family: var(--serif); font-size: clamp(1.18rem, 1.7vw, 1.46rem); line-height: 1.46; max-width: 52ch; font-weight: 400; }
  .composite .synth :global(em) { font-style: italic; }
  .composite .tally { font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-3); margin-top: 1.2rem; }
  .composite .tally :global(b) { color: var(--ink); }
  .composite .vantage { margin-top: 1rem; max-width: 46ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--ink-2); font-weight: 450; }
  @media (max-width: 680px) { .composite { grid-template-columns: 1fr; } }

  /* movement */
  .move { margin-top: clamp(3.5rem, 9vh, 6.5rem); }
  .move .g .fno { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-3); padding-top: 0.5rem; }
  .move .ey { font-family: var(--display); font-weight: 580; font-size: 0.84rem; letter-spacing: 0.04em; color: var(--hope); }
  .move h2 { font-family: var(--display); font-weight: 560; font-size: clamp(2rem, 4.2vw, 3.1rem); line-height: 1.05; letter-spacing: -0.03em; margin-top: 0.8rem; max-width: 19ch; text-wrap: balance; }
  .move .answer { max-width: var(--measure); margin-top: 1.1rem; font-family: var(--serif); font-style: italic; font-weight: 440; font-size: clamp(1.35rem, 2.3vw, 1.72rem); line-height: 1.22; color: var(--ink); text-wrap: pretty; }
  .move .intro { max-width: var(--measure); margin-top: 1.1rem; color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; text-wrap: pretty; }
  .move .intro + .intro { margin-top: 0.9rem; }
  .move .intro :global(em) { font-style: italic; color: var(--ink); }
  /* Tufte margin notes. The old float (13rem + 2.4rem gap) was wider than the free space
     beside the 38rem measure, so notes collided with the prose. Wide screens: hang the note
     in the true right margin, fully clear of the text (negative right margin pulls it past
     the column edge — the breakout mirror of the figures' left breakout). Narrower screens:
     a quiet left-rule aside in the flow. */
  .sidenote { font-family: var(--serif); font-size: var(--fs-small); line-height: 1.52; color: var(--ink-3); margin: 1rem 0 1.2rem; padding-left: 1.1rem; border-left: 1px solid var(--line-2); max-width: var(--measure); }
  .sidenote .n { font-style: italic; color: var(--hope); margin-right: 0.35em; }
  .sidenote :global(em) { font-style: italic; color: var(--ink-2); }
  @media (min-width: 1100px) {
    .sidenote { float: right; clear: right; width: 10.5rem; margin: 0.4rem -4rem 1.4rem 2rem; padding-left: 0; border-left: 0; font-size: 0.88rem; }
    .sidenote::before { content: ""; display: block; width: 2rem; height: 1px; background: var(--hope); opacity: 0.6; margin-bottom: 0.6rem; }
  }

  figure.fig { clear: both; margin: clamp(2rem, 4.5vh, 3.2rem) 0 0; }
  @media (min-width: 681px) { figure.fig { margin-left: calc(-1 * (var(--gutter) + 2.6rem)); width: calc(100% + var(--gutter) + 2.6rem); } }
  /* the chart title is content, not chrome — it reads at text size in the display face;
     only the period/meta on the right stays mono-small. */
  figure.fig .cap { display: flex; align-items: baseline; justify-content: space-between; gap: 0.4rem 1.5rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
  figure.fig .cap > span:first-child { font-family: var(--display); font-size: 1.06rem; font-weight: 460; letter-spacing: -0.01em; color: var(--ink-2); }
  figure.fig .cap :global(b) { color: var(--ink); font-weight: 620; }
  figure.fig .cap > span:last-child { font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-3); }
  /* chart SVG styling + the desktop/mobile render swap live in Chart.astro (which owns the svgs);
     this file keeps only how a chart is POSITIONED in the article grid (.sc, figure widths). */
  /* chart credit, matching the sub-charts' quiet band: the downloads recede to the source's weight —
     faint links, not a button-bar, underlining only on hover, so the metadata never shouts. */
  figure.fig figcaption { display: flex; justify-content: space-between; gap: 0.4rem 1.6rem; flex-wrap: wrap; align-items: baseline; margin-top: 0.95rem; }
  .src { font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-3); }
  .tools { display: flex; gap: 1.15rem; flex-wrap: wrap; }
  .tools a { font-family: var(--mono); font-size: var(--fs-meta); color: var(--ink-3); text-decoration: none; transition: color 0.15s ease; }
  .tools a:hover { color: var(--hope); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  details.prov { margin-top: 1.2rem; }
  details.prov summary { font-family: var(--mono); font-size: var(--fs-meta); letter-spacing: 0.02em; color: var(--ink-3); cursor: pointer; list-style: none; border-top: 1px solid var(--line); padding-top: 0.9rem; }
  details.prov summary:hover { color: var(--ink-2); }
  details.prov summary::-webkit-details-marker { display: none; }
  details.prov summary::before { content: "+ "; font-family: var(--mono); font-style: normal; }
  details.prov[open] summary::before { content: "– "; }
  details.prov .pb { font-size: var(--fs-small); line-height: 1.6; color: var(--ink-2); max-width: var(--measure); margin-top: 0.8rem; font-weight: 450; }
  details.prov .pb p + p { margin-top: 0.55rem; }
  details.prov .pb :global(b) { font-weight: 560; color: var(--ink); }
  details.prov .pb .fine { font-style: italic; color: var(--ink-3); font-size: 0.88rem; }
  details.prov .meta { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-3); display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; margin-top: 1rem; }

  /* the take strips — each column is capped by its temperature tick (the duel's design
     language), and the text sits a step below body size: commentary, not more article.
     Open columns, no boxes; the ticks anchor what used to dangle. */
  /* the other two magnifications, side by side under the global chart — world → region → country
     in one section (the keystone discipline, applied to every movement). */
  .levels { display: grid; grid-template-columns: 1fr; gap: clamp(2.6rem, 6vh, 4rem); margin-top: clamp(2.2rem, 5vh, 3.4rem); padding-top: clamp(1.9rem, 4vh, 2.7rem); border-top: 1px solid var(--line); }
  /* sub-charts share the main chart's left edge + width (same gutter extension as figure.fig),
     so the world / region / country lenses line up exactly. Grid gap handles vertical spacing. */
  .levels .kfig { margin: 0; }
  .levels .kfig + .kfig { margin-top: 0; padding: 0; border: 0; }
  .levels .kfig .sc .chart { width: 100%; }
  @media (min-width: 681px) { .levels .kfig { margin-left: calc(-1 * (var(--gutter) + 2.6rem)); width: calc(100% + var(--gutter) + 2.6rem); } }
  .takes { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.6rem); margin-top: 2.2rem; }
  .takes > div { position: relative; padding-top: 1rem; }
  .takes > div::before { content: ""; position: absolute; top: 0; left: 0; width: 1.6rem; height: 2px; border-radius: 2px; }
  .takes .hope::before { background: var(--hope); } .takes .desp::before { background: var(--despair); } .takes .conf::before { background: var(--uncertain); }
  .takes .t { font-family: var(--display); font-weight: 580; font-size: 0.8rem; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
  .takes .hope .t { color: var(--hope); } .takes .desp .t { color: var(--despair); } .takes .conf .t { color: var(--uncertain); }
  .takes p { font-size: var(--fs-small); line-height: 1.58; color: var(--ink-2); max-width: 34ch; font-weight: 450; }
  @media (max-width: 680px) { .takes { grid-template-columns: 1fr; gap: 1.7rem; } }
  /* movement takes span the wider evidence zone, aligning under the chart — same as the keystone's
     .dim .takes. The prose above stays in the narrow text column (max-width: var(--measure)). */
  @media (min-width: 681px) { .move .takes { margin-left: calc(-1 * (var(--gutter) + 2.6rem)); width: calc(100% + var(--gutter) + 2.6rem); } }

  .pull { font-family: var(--serif); font-weight: 400; font-style: italic; font-size: clamp(2.1rem, 4.7vw, 3.1rem); line-height: 1.14; letter-spacing: -0.015em; text-align: center; max-width: 30ch; margin: clamp(4.5rem, 12vh, 8rem) auto clamp(3rem, 7vh, 4.5rem); position: relative; color: var(--ink); text-wrap: balance; }
  .pull::before { content: "\201C"; position: absolute; top: -0.72em; left: 50%; transform: translateX(-50%); font-family: var(--serif); font-size: 2.8rem; line-height: 1; color: var(--hope); font-style: normal; opacity: 0.85; }
  .pull cite { display: block; font-family: var(--mono); font-style: normal; font-size: 0.7rem; letter-spacing: 0.04em; color: var(--ink-3); margin-top: 1.7rem; }

  /* numbered lower sections */
  .sec { margin-top: clamp(3.5rem, 9vh, 6rem); }
  .sec .g .num { font-family: var(--serif); font-style: italic; font-weight: 420; font-size: 3rem; color: var(--hope); line-height: 0.9; }
  .seclabel { font-family: var(--display); font-weight: 600; font-size: clamp(1.5rem, 2.8vw, 1.9rem); line-height: 1.1; letter-spacing: -0.022em; color: var(--ink); padding-bottom: 1.4rem; border-bottom: 1px solid var(--line-2); margin-bottom: 1.6rem; text-wrap: balance; }
  .seclead { max-width: var(--measure); color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; }

  /* lenses — a panel of voices, not a table. The name carries the voice (serif italic);
     each reading wears a quiet hope/despair colour rule instead of a repeated word-label. */
  .lens { display: grid; grid-template-columns: 13rem 1fr; gap: 1.1rem 3rem; padding-block: 1.7rem; border-top: 1px solid var(--line); align-items: start; }
  .lens:first-of-type { border-top: 0; padding-top: 0.3rem; }
  .lens .who { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 1.46rem; line-height: 1.08; color: var(--ink); display: block; }
  .lens .conf { font-family: var(--mono); font-size: 0.64rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-top: 0.55rem; display: block; }
  .lens .read { position: relative; padding-left: 1.1rem; max-width: 56ch; color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; text-wrap: pretty; }
  .lens .read + .read { margin-top: 0.75rem; }
  .lens .read::before { content: ""; position: absolute; left: 0; top: 0.5em; bottom: 0.25em; width: 2px; border-radius: 2px; }
  .lens .read.hope::before { background: var(--hope); }
  .lens .read.desp::before { background: var(--despair); }
  .lens .read .tag { display: block; font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 0.45rem; }
  .lens .read.hope .tag { color: var(--hope); }
  .lens .read.desp .tag { color: var(--despair); }
  @media (max-width: 600px) { .lens { grid-template-columns: 1fr; gap: 0.7rem; } }

  /* the two cases face off across a central hairline — the site's hope↔despair tension,
     drawn rather than stated. A short colour tick caps each side; no boxes, no fills. */
  .duel { display: grid; grid-template-columns: 1fr 1fr; }
  .duel .hp { padding-right: clamp(2rem, 5vw, 3.6rem); }
  .duel .dp { padding-left: clamp(2rem, 5vw, 3.6rem); border-left: 1px solid var(--line-2); }
  .duel h3 { position: relative; font-family: var(--display); font-weight: 580; font-size: 0.95rem; letter-spacing: 0.02em; padding-top: 1.05rem; margin-bottom: 0.9rem; }
  .duel h3::before { content: ""; position: absolute; top: 0; left: 0; width: 1.6rem; height: 2px; border-radius: 2px; }
  .duel .hp h3 { color: var(--hope); } .duel .dp h3 { color: var(--despair); }
  .duel .hp h3::before { background: var(--hope); } .duel .dp h3::before { background: var(--despair); }
  .duel p { max-width: 40ch; color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; text-wrap: pretty; }
  @media (max-width: 600px) { .duel { grid-template-columns: 1fr; gap: 1.8rem; } .duel .hp { padding-right: 0; } .duel .dp { padding-left: 0; border-left: 0; padding-top: 1.6rem; border-top: 1px solid var(--line-2); } }

  /* the verdict-changers: a calm, framed passage at lede size — it used to be set at headline
     size, so a full paragraph read as a wall. A quiet hope rule gives it shape; multiple authored
     paragraphs (split on a blank line) break the block so it flows instead of clamping. */
  .change { max-width: var(--measure); padding-left: 1.3rem; border-left: 2px solid color-mix(in srgb, var(--hope) 38%, transparent); }
  .change p { font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.52; font-weight: 400; color: var(--ink); text-wrap: pretty; }
  .change p + p { margin-top: 1rem; }
  .change p :global(b) { font-weight: 600; color: var(--hope); }

  /* methodology as a true reference list: each term/detail pair sits on its own ruled row with
     real air, so the entries stop collapsing into one block. */
  .method dl { display: grid; grid-template-columns: 13rem 1fr; gap: 0 2.6rem; margin-top: 1.7rem; }
  .method dt { font-family: var(--serif); font-weight: 600; font-size: 1.16rem; color: var(--ink); line-height: 1.32; letter-spacing: 0.005em; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .method dd { margin: 0; font-size: var(--fs-body); color: var(--ink-2); line-height: var(--lh-body); max-width: 58ch; font-weight: 450; text-wrap: pretty; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .method dt:first-of-type, .method dd:first-of-type { border-top: 0; padding-top: 0.2rem; }
  .method dd :global(b) { font-weight: 560; color: var(--ink); }
