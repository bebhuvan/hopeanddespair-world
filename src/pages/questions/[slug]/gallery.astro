---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Chart from '../../../components/Chart.astro';
import { smartenDeep } from '../../../lib/typo';
import { GALLERIES, galleryBars } from '../../../lib/galleries';

export async function getStaticPaths() {
  const qs = await getCollection('questions');
  return Object.keys(GALLERIES).map((slug) => {
    const q = qs.find((x) => x.id === slug);
    return { params: { slug }, props: { g: GALLERIES[slug], question: q?.data.question ?? '', theme: q?.data.theme ?? '', num: q?.data.kickerNumber ?? '' } };
  });
}

const { g, question, theme, num } = Astro.props;
const slug = Astro.params.slug;
const items = g.items.map((c) => ({ ...c, chart: galleryBars(c.ref), hook: smartenDeep(c.hook) })).filter((c) => c.chart);
const tops = [...new Set(items.map((i) => i.top))];
const article = `/questions/${slug}`;
---
<BaseLayout title={`Charts — ${question} — Hope & Despair`} description={g.blurb}>
  <section class="ghead">
    <p class="crumb"><a href="/gallery">Charts</a> <span class="sep">/</span> <a href={article}>{theme}</a></p>
    <h1>{smartenDeep(g.headline)}</h1>
    <p class="blurb">{smartenDeep(g.blurb)}</p>
    <p class="count">{items.length} charts · from <a href={article}>{question}</a> · {tops.length} different countries on top</p>
  </section>

  <section class="grid">
    {items.map((it) => (
      <figure class="card">
        <figcaption class="cap">
          <span class="kick">{it.kicker}</span>
          <span class="lead">{it.top}</span>
        </figcaption>
        <div class="sc"><Chart c={it.chart} /></div>
        <p class="hook">{it.hook}</p>
        <div class="foot">
          <span class="src">{it.chart.attribution} · {it.chart.license}</span>
          <a class="read" href={article}>Read the full question · {it.fig} <span aria-hidden="true">&rarr;</span></a>
        </div>
      </figure>
    ))}
  </section>

  <section class="more">
    <p class="ml">These charts all answer one question — <a href={article}>{question}</a> — read many ways.</p>
    <p class="all"><a href="/gallery">&larr; All chart galleries</a></p>
  </section>
</BaseLayout>

<style>
  .ghead { padding-block: clamp(3rem, 8vh, 5rem) clamp(1.2rem, 3vh, 2rem); }
  .crumb { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); }
  .crumb a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .crumb a:hover { color: var(--hope); border-color: var(--hope); }
  .crumb .sep { color: var(--line-2); margin: 0 0.3em; }
  .ghead h1 { font-family: var(--display); font-weight: 640; font-size: clamp(2.2rem, 5.4vw, 3.8rem); line-height: 1.05; letter-spacing: -0.035em; margin-top: 1.2rem; text-wrap: balance; }
  .ghead .blurb { max-width: 54ch; margin-top: 1.3rem; font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .ghead .count { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); margin-top: 1.3rem; }
  .ghead .count a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .ghead .count a:hover { color: var(--hope); border-color: var(--hope); }

  .grid { margin-top: clamp(1.6rem, 4vh, 2.6rem); display: grid; gap: clamp(2.4rem, 5vh, 3.6rem); }
  .card { border-top: 1px solid var(--line); padding-top: clamp(1.6rem, 3.5vh, 2.2rem); }
  .cap { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; margin-bottom: 1rem; }
  .cap .kick { font-family: var(--display); font-weight: 600; font-size: clamp(1.15rem, 2.4vw, 1.55rem); letter-spacing: -0.02em; }
  .cap .lead { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); white-space: nowrap; flex: none; }
  .cap .lead::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--despair); margin-right: 0.45em; vertical-align: 0.08em; }
  .sc { margin-inline: calc(-1 * clamp(0px, 1vw, 0.5rem)); }
  .hook { font-family: var(--serif); font-size: 1.05rem; line-height: 1.5; color: var(--ink-2); margin-top: 1.1rem; max-width: 60ch; text-wrap: pretty; }
  .foot { display: flex; align-items: baseline; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-top: 1rem; }
  .foot .src { font-family: var(--mono); font-size: 0.66rem; color: var(--ink-3); letter-spacing: 0.02em; }
  .foot .read { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-2); border-bottom: 1px solid var(--line-2); transition: color 0.3s, border-color 0.3s; white-space: nowrap; }
  .foot .read:hover { color: var(--hope); border-color: var(--hope); }

  .more { margin-top: clamp(3rem, 8vh, 5rem); border-top: 1px solid var(--line-2); padding-top: clamp(1.8rem, 4vh, 2.6rem); }
  .more .ml { font-family: var(--serif); font-size: 1.08rem; color: var(--ink-2); max-width: 54ch; }
  .more .ml a { color: var(--ink); border-bottom: 1px solid var(--line-2); }
  .more .ml a:hover { color: var(--hope); border-color: var(--hope); }
  .all { margin-top: 1.8rem; font-family: var(--mono); font-size: 0.74rem; }
  .all a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .all a:hover { color: var(--hope); border-color: var(--hope); }
</style>
