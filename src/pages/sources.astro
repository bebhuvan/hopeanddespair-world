---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Aggregate every source cited across published articles.
const questions = await getCollection('questions');
const seen = new Map<string, { name: string; url: string; license: string; vintage: string }>();
for (const q of questions) {
  for (const s of q.data.sources ?? []) {
    if (!seen.has(s.name)) seen.set(s.name, { name: s.name, url: s.url, license: s.license, vintage: s.vintage });
  }
}
const sources = [...seen.values()].sort((a, b) => a.name.localeCompare(b.name));
---
<BaseLayout title="Sources — Hope & Despair" description="Every open dataset behind the atlas, with license and vintage.">
  <article class="page">
    <header class="head">
      <p class="eyebrow">Sources</p>
      <h1>Every dataset behind the atlas.</h1>
      <p class="lead">All of it is open and credited — with the licence and the vintage we archived. Per-article
        citations, with downloadable data and lineage, live at the foot of each piece.</p>
      {sources.length > 0 && <p class="count">{sources.length} sources cited across the atlas</p>}
    </header>
    {sources.length === 0 ? (
      <p class="empty">Sources are listed as articles are published.</p>
    ) : (
      <ol class="srcs">
        {sources.map((s) => (
          <li><b>{s.name}</b> — <a href={s.url} rel="noopener" target="_blank">{s.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}<span class="ext"> ↗</span></a> · {s.license} · vintage {s.vintage}</li>
        ))}
      </ol>
    )}
    <p class="back"><a href="/">← Back to the atlas</a> <span class="sep">·</span> <a href="/methodology">How the numbers are handled →</a></p>
  </article>
</BaseLayout>

<style>
  .page { max-width: 44rem; padding-block: clamp(3rem, 8vh, 5.5rem) 2rem; }
  .head .eyebrow { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .head h1 { font-family: var(--display); font-weight: 620; font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.06; letter-spacing: -0.032em; margin-top: 1.1rem; }
  .lead { max-width: var(--measure); font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.5; color: var(--ink-2); margin-top: 1.4rem; text-wrap: pretty; }
  .count { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); margin-top: 1.2rem; }
  .empty { margin-top: 1.6rem; color: var(--ink-3); font-style: italic; font-family: var(--serif); }

  .srcs { list-style: none; counter-reset: s; font-family: var(--mono); font-size: 0.82rem; line-height: 1.9; color: var(--ink-3); margin-top: clamp(2rem, 5vh, 3rem); }
  .srcs li { counter-increment: s; position: relative; padding-left: 2.2rem; margin-bottom: 0.7rem; }
  .srcs li::before { content: counter(s); position: absolute; left: 0; top: -0.02em; font-family: var(--serif); font-style: italic; color: var(--hope); font-size: 1.05rem; }
  .srcs b { color: var(--ink); font-weight: 500; font-family: var(--serif); font-size: 0.94rem; }
  .srcs a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .srcs a:hover { color: var(--hope); border-color: var(--hope); }
  .srcs .ext { border: 0; color: var(--ink-3); }

  .back { margin-top: clamp(2.6rem, 6vh, 3.6rem); font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); }
  .back a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .back a:hover { color: var(--hope); border-color: var(--hope); }
  .back .sep { margin: 0 0.4em; color: var(--line-2); }
</style>
