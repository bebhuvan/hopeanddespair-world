---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { smartenDeep } from '../lib/typo';
import { categories } from '../lib/categories';
import { homeCells } from '../lib/home';

const questions = (await getCollection('questions'))
  .map((q) => ({ ...q, data: smartenDeep(q.data) }))
  .sort((a, b) => a.data.order - b.data.order);
const count = String(questions.length).padStart(2, '0');

// The "state of the world" wall: every question as a real signature sparkline, coloured by its
// honest lean on the hope↔despair axis (built in src/lib/home.ts).
const cells = homeCells(questions);

// Browse-by-domain: the keystone shown apart, the thematic domains as the grid.
const catCards = categories.map((c) => {
  const qs = questions.filter((q) => c.themes.includes(q.data.theme));
  return { ...c, total: qs.length, open: qs.filter((q) => q.data.status === 'published').length };
});
const keystone = catCards.find((c) => c.keystone);
const domains = catCards.filter((c) => !c.keystone && c.total > 0);

// Voices — verifiable lines on hope, despair, progress. The opening mark wears the quote's temperature.
const voices = [
  { text: 'Things can be bad, and getting better.', who: 'Hans Rosling', src: 'Factfulness', lean: 'both' },
  { text: 'Pessimism of the intellect, optimism of the will.', who: 'Antonio Gramsci', src: 'Prison Notebooks', lean: 'both' },
  { text: 'Not everything that is faced can be changed, but nothing can be changed until it is faced.', who: 'James Baldwin', src: 'As Much Truth As One Can Bear', lean: 'despair' },
  { text: 'Hope is not the conviction that something will turn out well, but the certainty that something makes sense, regardless of how it turns out.', who: 'Václav Havel', src: 'Disturbing the Peace', lean: 'hope' },
  { text: 'In the depth of winter, I finally learned that within me there lay an invincible summer.', who: 'Albert Camus', src: 'Return to Tipasa', lean: 'hope' },
  { text: 'To be truly radical is to make hope possible, rather than despair convincing.', who: 'Raymond Williams', src: 'Resources of Hope', lean: 'both' },
  { text: 'We must cultivate our garden.', who: 'Voltaire', src: 'Candide', lean: 'both' },
  { text: 'Hope is the necessary, but insufficient, precondition for survival.', who: 'Cory Doctorow', src: 'on hope vs. optimism', lean: 'hope' },
];
---
<BaseLayout title="Hope & Despair — A living atlas of human progress, suffering, and uncertainty">
  <div class="home bleed"><div class="home-in">

    <!-- hero: centred, grand — the thesis stated plainly -->
    <section class="hero">
      <p class="eyebrow reveal d1">A living atlas, revised in the open.</p>
      <h1 class="statement">
        <b class="reveal d2">The world is getting better.</b>
        <b class="reveal d3">The world is getting worse.</b>
        <b class="reveal d4">Both are true.</b>
      </h1>
      <p class="dek reveal d4">One question at a time, answered only with open data. We read each at two distances:
        the long arc of the centuries, and the world as it feels this year. The answer usually changes between
        them, and <em>the change is the point.</em></p>
    </section>

    <!-- the wall: the whole atlas at a glance -->
    <section id="atlas" class="wall">
      <div class="sec-head"><span class="sec-eyebrow">The atlas</span><span class="sec-n">{count} questions, each read at two distances</span></div>
      <p class="wall-lead">Every line is one question’s signature measure, drawn from its own evidence. The colour
        is where the honest answer leans: <b class="h">toward hope</b>, <b class="d">toward despair</b>, or
        <b class="u">genuinely both</b>. The mix is the finding.</p>
      <ol class="grid">
        {cells.map((c) => (
          <li class={`cell ${c.live ? 'live' : 'draft'}`} style={`--ac:${c.color}`}>
            <a href={`/questions/${c.id}`}>
              <div class="ch"><span class="cn">{c.num}</span><span class="ct">{c.theme}</span>{!c.live && <span class="cs">in progress</span>}</div>
              <h2 class="cq">{c.question}</h2>
              {c.spark && (
                <figure class="cspark">
                  <svg viewBox={c.spark.viewBox} preserveAspectRatio="none" aria-hidden="true" set:html={c.spark.inner} />
                  {c.metric && <figcaption class="cm">{c.metric}</figcaption>}
                </figure>
              )}
              <p class="cv">{c.verdict}.</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <!-- the emotional pivot: one line that holds the whole thesis -->
    <section class="creed">
      <blockquote>Be joyful<br/>though you have considered<br/>all the facts.</blockquote>
      <cite>Wendell Berry <span class="csrc">Manifesto: The Mad Farmer Liberation Front, 1973</span></cite>
    </section>

    <!-- how to read this -->
    <section class="how">
      <span class="sec-eyebrow">How to read this</span>
      <div class="hgrid">
        <div class="hi"><h3>One question at a time</h3><p>Each article asks a single honest question and answers
          it only with open, cited data. Every number traces to its source.</p></div>
        <div class="hi"><h3>Read at every distance</h3><p>The same measure, seen from the ten-thousand-year arc
          and from a single year. The verdict often reverses between the two, and that reversal is the thing
          worth seeing.</p></div>
        <div class="hi"><h3>Three temperatures</h3><p>Every chart is read three ways: <b class="h">hope</b>,
          <b class="d">despair</b>, and <b class="u">confusion</b>, which gets equal billing here, never a
          footnote.</p></div>
      </div>
    </section>

    <!-- browse by domain -->
    <section class="explore">
      <span class="sec-eyebrow">Browse by domain</span>
      {keystone && (
        <a class="key" href={`/categories/${keystone.slug}`}>
          <span class="kn">{keystone.name}</span>
          <span class="kb">{keystone.blurb}</span>
          <span class="kgo">Start here <span class="ar">→</span></span>
        </a>
      )}
      <ul class="doms">
        {domains.map((c) => (
          <li><a href={`/categories/${c.slug}`}>
            <span class="dn">{c.name}</span>
            <span class="db">{c.blurb}</span>
            <span class="dc">{c.total} {c.total === 1 ? 'question' : 'questions'}{c.open < c.total ? ` · ${c.open} open` : ''}</span>
          </a></li>
        ))}
      </ul>
    </section>

    <!-- voices -->
    <section class="voices">
      <span class="sec-eyebrow">On hope &amp; despair</span>
      <p class="vlead">Both are always true. <em>The work is deciding which one you are looking at, and being
        honest about the lens.</em></p>
      <ul class="qlist">
        {voices.map((v) => (
          <li class={`vq ${v.lean}`}>
            <blockquote>{v.text}</blockquote>
            <cite><span class="who">{v.who}</span><span class="src">{v.src}</span></cite>
          </li>
        ))}
      </ul>
      <p class="vmeta">Revised in the open · data and prose are <a href="/methodology">open and cited</a> · CC&nbsp;BY&nbsp;4.0</p>
    </section>

  </div></div>
</BaseLayout>

<style>
  /* one wide, calm canvas for the whole landing — every section shares this width and left edge,
     so the page reads as a single composition instead of a narrow column floating in a void. */
  .home-in { max-width: min(94vw, 80rem); margin-inline: auto; padding-inline: var(--margin); }
  .home section { padding-block: clamp(2.8rem, 6vh, 4.6rem); border-top: 1px solid var(--line); }
  .home .hero { border-top: 0; }

  /* ── hero: centred and grand ── */
  .hero { text-align: center; padding-block: clamp(4rem, 11vh, 7.5rem) clamp(3rem, 7vh, 5rem); }
  .eyebrow { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--ink-3); }
  .statement { font-family: var(--display); font-weight: 600; font-size: clamp(2.2rem, 6vw, 5rem); line-height: 1.06; letter-spacing: -0.036em; margin-top: 1.6rem; text-wrap: nowrap; }
  .statement b { display: block; font-weight: 600; }
  .statement b:nth-child(1) { color: var(--hope); }
  .statement b:nth-child(2) { color: var(--despair); }
  .statement b:nth-child(3) { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -0.015em; color: var(--ink); }
  @media (max-width: 560px) { .statement { text-wrap: balance; font-size: clamp(2rem, 8.4vw, 2.9rem); } }
  .dek { font-size: clamp(1.18rem, 1.5vw, 1.4rem); line-height: 1.56; max-width: 52ch; margin: 2rem auto 0; color: var(--ink-2); text-wrap: pretty; }
  .dek em { color: var(--ink); }

  /* ── one calm label voice for every section ── */
  .sec-eyebrow { font-family: var(--display); font-weight: 580; font-size: 0.84rem; letter-spacing: 0.01em; color: var(--ink-3); display: block; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .sec-head .sec-eyebrow { font-size: 1.04rem; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; }
  .sec-n { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-3); }

  /* ── the wall ── */
  .wall-lead { max-width: 62ch; margin-top: 1rem; color: var(--ink-2); font-size: var(--fs-body); line-height: var(--lh-body); font-weight: 450; text-wrap: pretty; }
  .wall-lead .h { color: var(--hope); font-weight: 560; } .wall-lead .d { color: var(--despair); font-weight: 560; } .wall-lead .u { color: var(--stone); font-weight: 560; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); column-gap: clamp(1.8rem, 3vw, 3.4rem); margin-top: clamp(1.8rem, 4vh, 2.6rem); }
  .cell { border-top: 1px solid var(--line); }
  .cell:nth-child(-n+3) { border-top: 0; }
  .cell a { display: flex; flex-direction: column; height: 100%; padding: clamp(1.5rem, 3vh, 2.1rem) 0; }
  .ch { display: flex; align-items: baseline; gap: 0.6rem; }
  .cell .cn { font-family: var(--display); font-weight: 600; font-size: 0.92rem; color: var(--ink-3); letter-spacing: 0.01em; transition: color 0.3s; }
  .cell .ct { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .cell .cs { font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-left: auto; }
  .cq { font-family: var(--display); font-weight: 560; font-size: clamp(1.28rem, 1.5vw, 1.55rem); line-height: 1.08; letter-spacing: -0.022em; margin-top: 0.75rem; min-height: 2.3em; text-wrap: balance; transition: color 0.3s; }
  .cell a:hover .cq, .cell a:hover .cn { color: var(--ac); }
  .cell.draft .cq { color: var(--ink-2); font-weight: 500; }
  .cspark { margin: 1.2rem 0 0; }
  .cspark svg { width: 100%; height: 64px; display: block; overflow: visible; }
  .cspark .cm { font-family: var(--mono); font-size: 0.62rem; color: var(--ink-3); margin-top: 0.6rem; line-height: 1.4; }
  .cv { font-family: var(--serif); font-style: italic; font-size: 1.06rem; line-height: 1.34; color: var(--ink-2); margin-top: auto; padding-top: 1.05rem; text-wrap: pretty; }
  @media (max-width: 880px) { .grid { grid-template-columns: repeat(2, 1fr); } .cell:nth-child(-n+3) { border-top: 1px solid var(--line); } .cell:nth-child(-n+2) { border-top: 0; } .cq { min-height: 0; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .cell:nth-child(-n+2) { border-top: 1px solid var(--line); } .cell:first-child { border-top: 0; } }

  /* ── the creed: one grand, evocative line, centred on white ── */
  .creed { text-align: center; padding-block: clamp(4rem, 10vh, 7rem) !important; }
  .creed blockquote { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: clamp(2.2rem, 5vw, 4rem); line-height: 1.12; letter-spacing: -0.018em; color: var(--ink); text-wrap: balance; }
  .creed cite { display: block; font-style: normal; font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.06em; color: var(--ink-3); margin-top: 1.8rem; }
  .creed cite::before { content: "— "; }
  .creed cite .csrc { display: block; margin-top: 0.45rem; letter-spacing: 0.03em; color: color-mix(in srgb, var(--ink-3) 78%, transparent); }

  /* ── how to read this ── */
  .hgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.8rem, 3.5vw, 3.4rem); margin-top: clamp(1.4rem, 3vh, 2rem); }
  .how h3 { font-family: var(--display); font-weight: 580; font-size: 1.08rem; line-height: 1.2; letter-spacing: -0.015em; color: var(--ink); }
  .how p { margin-top: 0.6rem; font-size: var(--fs-small); line-height: 1.6; color: var(--ink-2); font-weight: 450; max-width: 34ch; text-wrap: pretty; }
  .how .h { color: var(--hope); } .how .d { color: var(--despair); } .how .u { color: var(--uncertain); }
  @media (max-width: 680px) { .hgrid { grid-template-columns: 1fr; gap: 1.6rem; } }

  /* ── browse by domain ── */
  .explore .key { display: grid; gap: 0.5rem; margin-top: clamp(1.4rem, 3vh, 2rem); padding-bottom: clamp(1.6rem, 4vh, 2.4rem); margin-bottom: clamp(1.6rem, 4vh, 2.4rem); border-bottom: 1px solid var(--line-2); }
  .explore .key .kn { font-family: var(--display); font-weight: 640; font-size: clamp(1.5rem, 2.4vw, 2rem); letter-spacing: -0.028em; line-height: 1.04; color: var(--ink); transition: color 0.3s; }
  .explore .key:hover .kn { color: var(--hope); }
  .explore .key .kb { font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.45; color: var(--ink-2); max-width: 52ch; text-wrap: pretty; }
  .explore .key .kgo { font-family: var(--display); font-weight: 560; font-size: 0.9rem; color: var(--hope); margin-top: 0.2rem; }
  .explore .key .kgo .ar { display: inline-block; transition: margin-left 0.3s; }
  .explore .key:hover .kgo .ar { margin-left: 0.3em; }
  .doms { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.4rem, 3vw, 2.6rem) clamp(1.8rem, 3vw, 3.4rem); }
  .doms li { border-top: 1px solid var(--line); }
  .doms a { display: grid; gap: 0.4rem; padding-top: 1.1rem; }
  .doms .dn { font-family: var(--display); font-weight: 580; font-size: 1.3rem; letter-spacing: -0.02em; line-height: 1.1; color: var(--ink); transition: color 0.3s; }
  .doms a:hover .dn { color: var(--hope); }
  .doms .db { font-size: var(--fs-small); line-height: 1.5; color: var(--ink-2); max-width: 34ch; text-wrap: pretty; }
  .doms .dc { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--ink-3); margin-top: 0.15rem; }
  @media (max-width: 760px) { .doms { grid-template-columns: 1fr; } }

  /* ── voices: a two-column anthology, each opening mark wearing the quote's temperature ── */
  .vlead { max-width: 56ch; margin-top: clamp(1.2rem, 3vh, 1.8rem); font-family: var(--serif); font-size: var(--fs-lede); line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .vlead em { font-style: italic; color: var(--ink); }
  .qlist { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); column-gap: clamp(2.4rem, 5vw, 4.5rem); margin-top: clamp(1.6rem, 3.5vh, 2.4rem); }
  .vq { position: relative; padding: clamp(1.5rem, 3vh, 2rem) 0 clamp(1.5rem, 3vh, 2rem) 2.4rem; border-top: 1px solid var(--line); }
  .vq:nth-child(-n+2) { border-top: 0; }
  .vq::before { content: "\201C"; position: absolute; left: 0; top: clamp(1.5rem, 3vh, 2rem); font-family: var(--serif); font-size: 2.3rem; line-height: 0.7; color: var(--ink-3); }
  .vq.hope::before { color: var(--hope); } .vq.despair::before { color: var(--despair); } .vq.both::before { color: var(--uncertain); }
  .vq blockquote { font-family: var(--serif); font-size: clamp(1.24rem, 1.7vw, 1.5rem); line-height: 1.36; color: var(--ink); text-wrap: pretty; }
  .vq cite { display: block; margin-top: 0.8rem; font-style: normal; }
  .vq cite .who { font-family: var(--display); font-weight: 580; font-size: 0.95rem; color: var(--ink-2); }
  .vq cite .src { font-family: var(--mono); font-size: 0.68rem; color: var(--ink-3); margin-left: 0.7em; letter-spacing: 0.02em; }
  .vmeta { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-3); margin-top: clamp(2rem, 5vh, 3rem); padding-top: 1.4rem; border-top: 1px solid var(--line-2); }
  .vmeta a { color: var(--ink-2); border-bottom: 1px solid var(--line-2); }
  .vmeta a:hover { color: var(--hope); border-color: var(--hope); }
  @media (max-width: 640px) { .qlist { grid-template-columns: 1fr; } .vq:nth-child(2) { border-top: 1px solid var(--line); } .vq:first-child { border-top: 0; } }
</style>
