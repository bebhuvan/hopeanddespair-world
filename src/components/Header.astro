---
const nav = [
  { href: '/', label: 'The Atlas' },
  { href: '/gallery', label: 'Charts' },
  { href: '/methodology', label: 'Method' },
  { href: '/sources', label: 'Sources' },
  { href: '/about', label: 'About' },
];
---
<header class="site">
  <div class="bar">
    <a class="word" href="/">
      <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
        <!-- the thesis as a mark: one coin, two readings — hope and despair, ringed into one -->
        <path d="M8 1.6 a6.4 6.4 0 0 0 0 12.8 z" fill="var(--hope)" />
        <path d="M8 1.6 a6.4 6.4 0 0 1 0 12.8 z" fill="var(--despair)" />
        <line x1="8" y1="1.2" x2="8" y2="14.8" stroke="var(--bg)" stroke-width="0.8" />
        <circle cx="8" cy="8" r="6.4" fill="none" stroke="var(--ink)" stroke-width="0.9" />
      </svg>
      <span class="wm">Hope <span class="amp">&amp;</span> Despair</span>
    </a>
    <nav>{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
  </div>
</header>

<style>
  .site {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    height: 66px; max-width: calc(var(--col) + var(--gutter));
    margin-inline: auto; padding-inline: var(--margin);
  }
  .word { display: inline-flex; align-items: center; gap: 0.62rem; }
  .word .mark { width: 1.04rem; height: 1.04rem; display: block; flex: none; }
  .wm { font-family: var(--display); font-weight: 540; font-size: 1.1rem; letter-spacing: -0.018em; color: var(--ink); }
  .amp { font-family: var(--serif); font-style: italic; font-weight: 440; color: var(--hope); margin-inline: 0.06em; }
  nav { display: flex; gap: 1.9rem; font-family: var(--serif); font-size: 1rem; color: var(--ink-2); }
  nav a { position: relative; padding-bottom: 3px; transition: color 0.3s; }
  nav a:hover { color: var(--ink); }
  nav a::after {
    content: ""; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px;
    background: var(--hope); transition: right 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  nav a:hover::after { right: 0; }
  /* phones: one row can't hold the wordmark + four links, so stack — wordmark, then the nav on its
     own centred row beneath. Kept visible (no JS hamburger needed for four short links). */
  @media (max-width: 600px) {
    .bar { flex-direction: column; height: auto; gap: 0.6rem; padding-block: 0.8rem; }
    nav { gap: 1.6rem; font-size: 0.96rem; flex-wrap: wrap; justify-content: center; }
  }
</style>
