---
// Preload ONLY the display face — it sets the hero headline, the LCP element, and is light
// (~46 KB). The serif (~120 KB) and mono are heavier and not on the LCP path; they swap in
// async (font-display: swap), so they never compete for the headline's bandwidth.
import schibstedWoff2 from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';

// Self-hosted fonts (PERFORMANCE.md — no render-blocking Google Fonts). The serif must come from
// the opsz builds: a default fontsource import is wght-only + upright, which disables optical
// sizing and renders every italic as a synthetic oblique.
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/spline-sans-mono';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;                                   // og image path, relative to the site root
  type?: string;                                    // og:type — 'website' | 'article'
  jsonld?: Record<string, any> | Record<string, any>[];   // page-specific structured data
}
const {
  title,
  description = 'A living atlas answering whether the world is getting better or worse — one honest question at a time, with open, cited data. Progress and catastrophe coexist; the answer depends on the lens.',
  image = '/og.png',
  type = 'website',
  jsonld,
} = Astro.props;

const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

// Sitewide structured data — the publication and its author. Page-specific schema is appended.
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Hope & Despair',
  alternateName: 'hopeanddespair.world',
  url: site.href,
  description: 'A living atlas of human progress, suffering, and uncertainty.',
  inLanguage: 'en',
  license: 'https://creativecommons.org/licenses/by/4.0/',
  publisher: {
    '@type': 'Person',
    name: 'Bhuvan',
    url: 'https://bebhuvan.com',
    sameAs: ['https://twitter.com/bebhuvan', 'https://www.linkedin.com/in/bebhuvan'],
  },
};
const lds = [siteLd, ...(jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [])];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="author" content="Bhuvan" />

    <!-- preload the LCP font (the display headline) only -->
    <link rel="preload" href={schibstedWoff2} as="font" type="font/woff2" crossorigin />

    <!-- open graph + twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Hope & Despair" />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@bebhuvan" />

    <link rel="alternate" type="application/rss+xml" title="Hope & Despair" href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath d='M8 1.6a6.4 6.4 0 000 12.8z' fill='%230F7A52'/%3E%3Cpath d='M8 1.6a6.4 6.4 0 010 12.8z' fill='%23C0492B'/%3E%3Cline x1='8' y1='1.2' x2='8' y2='14.8' stroke='%23fff' stroke-width='0.8'/%3E%3Ccircle cx='8' cy='8' r='6.4' fill='none' stroke='%2314130F' stroke-width='0.9'/%3E%3C/svg%3E" />

    <script type="application/ld+json" set:html={JSON.stringify(lds)} />
  </head>
  <body>
    <Header />
    <div class="wrap"><main data-pagefind-body><slot /></main></div>
    <Footer />
  </body>
</html>
