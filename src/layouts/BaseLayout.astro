---
// Self-hosted fonts (PERFORMANCE.md — no render-blocking Google Fonts).
import '@fontsource-variable/fraunces';
import '@fontsource-variable/newsreader';
import '@fontsource/geist-sans/300.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A living atlas of human progress, suffering, and uncertainty.' } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='none' stroke='%230FA67E'/%3E%3Cpath d='M8 1a7 7 0 000 14z' fill='%230FA67E'/%3E%3C/svg%3E" />
    {/* no-FOUC theme: set before first paint */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="spine" aria-hidden="true"><div class="spine-thumb" id="spineThumb"></div></div>
    <div class="wrap">
      <Header />
      <slot />
      <Footer />
    </div>

    <script is:inline>
      // theme toggle
      const tg = document.getElementById('themeToggle');
      if (tg) tg.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.getAttribute('data-theme') === 'dark';
        const next = dark ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        tg.textContent = dark ? 'Dark' : 'Light';
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // temperature scroll-spine — transform/opacity + a CSS var only (no layout, no repaint thrash)
      const thumb = document.getElementById('spineThumb');
      if (thumb) {
        let queued = false;
        const update = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          thumb.style.setProperty('--y', (p * (window.innerHeight - 50)) + 'px');
          thumb.style.setProperty('--c', p < 0.5
            ? `color-mix(in srgb, var(--hope), var(--uncertain) ${Math.round(p * 200)}%)`
            : `color-mix(in srgb, var(--uncertain), var(--despair) ${Math.round((p - 0.5) * 200)}%)`);
        };
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        addEventListener('resize', update);
        update();
      }
    </script>

    <style>
      .spine {
        position: fixed; top: 0; left: clamp(0.55rem, 2.4vw, 2.4rem); width: 2px; height: 100vh;
        z-index: 60; pointer-events: none;
        background: linear-gradient(180deg,
          color-mix(in srgb, var(--hope) 45%, transparent),
          color-mix(in srgb, var(--uncertain) 30%, transparent),
          color-mix(in srgb, var(--despair) 45%, transparent));
        opacity: 0.38;
      }
      .spine-thumb {
        position: absolute; left: -2px; width: 6px; height: 50px; border-radius: 3px; top: 0;
        transform: translateY(var(--y, 0)); background: var(--c, var(--accent));
        transition: background 0.2s linear;
      }
      @media (max-width: 760px) { .spine { display: none; } }
    </style>
  </body>
</html>
